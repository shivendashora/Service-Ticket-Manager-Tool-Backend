# JWT signing
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
# Access token / cookie lifetime in minutes
TOKEN_EXPIRY_TIME=60

# PostgreSQL connection string
DB_URL=postgresql://postgres:postgres@localhost:5432/service-ticket-platform

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional: where uploaded images are stored (defaults to ./uploads)
# UPLOAD_DIR=

# Gmail API notifications (see scripts/get_gmail_refresh_token.py)
# OAuth client of type "Desktop app", in the same Google Cloud project
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Printed by scripts/get_gmail_refresh_token.py
GMAIL_REFRESH_TOKEN=
# The Gmail address you signed in with when creating the refresh token
GMAIL_SENDER=
